 {{ $('Update in sheet').item.json['Invoice ID'] }}\nTransaction ID: {{ $('Update in sheet').item.json['Transaction ID'] }}\nAmount: ${{$('Get row(s) in sheet').item.json[\"Amount\"]}}\n\nThank you for your cooperation.\n\nBest regards,\nFinance Team","options":{}},"type":"n8n-nodes-base.gmail","typeVersion":2.2,"position":[784,-192],"id":"4ca59c9d-e755-45f4-ab37-644f0dc5efba","name":"Send a message payment completed","webhookId":"1fc9e1e8-1872-4b22-80b7-43e704c2ac09","credentials":{"gmailOAuth2":{"id":"1PtGDX4HFmxTliE6","name":"Gmail account"}},"onError":"continueErrorOutput"},{"parameters":{},"type":"n8n-nodes-base.errorTrigger","typeVersion":1,"position":[-176,2224],"id":"7d6464e9-1ae5-4d25-bf77-909a489b5021","name":"Error Trigger"},{"parameters":{"chatId":"-5265822919","text":"=Email sending failed for invoice {{$json[\"Invoice ID\"] \n\n $json.invoice_id}}. Please check Gmail node.","additionalFields":{}},"type":"n8n-nodes-base.telegram","typeVersion":1.2,"position":[1216,-32],"id":"bbd3cf8e-d9ab-4ab9-bfd2-23d481325b9c","name":"Send a text message4","webhookId":"e19d0831-2e36-4d71-bc54-6343562eb8dc","credentials":{"telegramApi":{"id":"0N25LYzyYyZsOUvL","name":"Telegram account"}}},{"parameters":{"chatId":"-5265822919","text":"=Email Weekly Report sending failed.\n\nPlease check Gmail node.","additionalFields":{}},"type":"n8n-nodes-base.telegram","typeVersion":1.2,"position":[1056,656],"id":"2483d6fb-945f-4fa9-8791-2a19fc455e6b","name":"Send a text message5","webhookId":"34bcc736-3b3b-42a9-953f-b5594458a455","credentials":{"telegramApi":{"id":"0N25LYzyYyZsOUvL","name":"Telegram account"}}},{"parameters":{"jsCode":"const items = $input.all();\n\nlet totalAmount = 0;\n\nconst lines = items.map((item, index) => {\n  const invoiceId = item.json[\"Invoice ID\"] || \"N/A\";\n  const status = item.json[\"Status\"] || \"Unknown\";\n  const amount = Number(item.json[\"Amount\"] || 0);\n\n  totalAmount += amount;\n\n  return `${index + 1}. ${invoiceId} | Status: ${status} | Amount: $${amount}`;\n});\n\nconst message =\n`The following invoices were skipped because they are not approved.\n\nPayment was not processed for ${items.length} invoice(s).\nTotal amount: $${totalAmount}\n\n${lines.join('\\n')}`;\n\nreturn [{ json: { message } }];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[-64,0],"id":"b58f2c6b-b173-4abd-9a26-dda4f1dd910e","name":"Code in JavaScript1"},{"parameters":{"chatId":"-5265822919","text":"={{$json.message}}","additionalFields":{}},"type":"n8n-nodes-base.telegram","typeVersion":1.2,"position":[144,0],"id":"8af2ac9a-42e0-468a-94fa-42dc02eea552","name":"Send a Payment was not processed messsage","webhookId":"78eef5da-7b03-47b6-8309-13adb6ea23aa","credentials":{"telegramApi":{"id":"0N25LYzyYyZsOUvL","name":"Telegram account"}}},{"parameters":{"jsCode":"const items = $input.all();\n\nlet totalAmount = 0;\n\nconst lines = items.map((item, index) => {\n  const invoiceId = $('Update in sheet').first().json['Invoice ID'] || \"N/A\";\n  const transactionId = $('Update in sheet').first().json['Transaction ID'] || \"N/A\";\n  const amount = Number($('Update in sheet').first().json.Amount || 0);\n\n  totalAmount += amount;\n\n  return `${index + 1}. Invoice ${invoiceId} has been paid.\\nTransaction ID: ${transactionId}\\nAmount: $${amount}`;\n});\n\nconst message =\n`Payment completed for ${items.length} invoice(s).\\nTotal amount: $${totalAmount}\\n\\n${lines.join('\\n\\n')}`;\n\nreturn [{ json: { message } }];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[1008,-240],"id":"709f1c76-8aa1-4fad-a570-e49d941085c2","name":"Code in JavaScript2"},{"parameters":{"jsCode":"let paidItems = [];\nlet unpaidItems = [];\nlet overdueItems = []; \nlet totalPaid = 0;\nlet totalUnpaid = 0;\nlet totalOverdue = 0;\n\n// Lấy ngày báo cáo từ node Get Current Time ngay phía trước\nlet reportDate = $input.first().json['Report Date'] || 'Chưa xác định';\n\nlet today = new Date();\nlet sevenDaysAgo = new Date(today);\nsevenDaysAgo.setDate(today.getDate() - 7);\n\nlet thirtyDaysAgo = new Date(today);\nthirtyDaysAgo.setDate(today.getDate() - 30);\n\n// BÍ QUYẾT Ở ĐÂY: Gọi đích danh node Google Sheets để lấy toàn bộ danh sách 6 dòng\nlet sheetData = $('Get row(s) in sheet1').all();\n\nfor (let item of sheetData) {\n  let status = item.json.Status; \n  let invoiceID = item.json['Invoice ID'];     \n  let amount = parseFloat(item.json.Amount) || 0; \n  let formattedAmount = amount.toLocaleString('en-US');\n  \n  let receivedDate = new Date(item.json['Received Date']); \n  let paymentDate = new Date(item.json['Payment Date']);\n\n  if (status === 'Paid') {\n    if (paymentDate >= sevenDaysAgo) {\n        paidItems.push(`${invoiceID} ($${formattedAmount})`);\n        totalPaid += amount;\n    }\n  } else {\n    // Chưa thanh toán (các dòng trạng thái \"High\" trong sheet của bạn)\n    if (receivedDate < thirtyDaysAgo) {\n        overdueItems.push(`${invoiceID} ($${formattedAmount})`);\n        totalOverdue += amount;\n    } else {\n        unpaidItems.push(`${invoiceID} ($${formattedAmount})`);\n        totalUnpaid += amount;\n    }\n  }\n}\n\n// Format tổng tiền\nlet formattedTotalPaid = totalPaid.toLocaleString('en-US');\nlet formattedTotalUnpaid = totalUnpaid.toLocaleString('en-US');\nlet formattedTotalOverdue = totalOverdue.toLocaleString('en-US');\n\n// Khung nội dung tin nhắn\nlet message = \"BAO CAO THANH TOAN TUAN NAY\\n\";\nmessage += `Date: ${reportDate}\\n\\n`;\n\nmessage += \"DA THANH TOAN (Trong 7 ngay qua):\\n\";\nif (paidItems.length > 0) {\n  message += \"- \" + paidItems.join(\"\\n- \") + \"\\n\";\n  message += `Tong da thanh toan: $${formattedTotalPaid}\\n\\n`;\n} else {\n  message += `Khong co hoa don nao.\\n\\n`;\n}\n\nmessage += \"CHUA THANH TOAN (Phat sinh gan day):\\n\";\nif (unpaidItems.length > 0) {\n  message += \"- \" + unpaidItems.join(\"\\n- \") + \"\\n\";\n  message += `Tong chua thanh toan (moi): $${formattedTotalUnpaid}\\n\\n`;\n} else {\n  message += \"Khong co hoa don nao.\\n\\n\";\n}\n\nmessage += \"QUA HAN THANH TOAN (Tren 30 ngay - Can doi gap):\\n\";\nif (overdueItems.length > 0) {\n  message += \"- \" + overdueItems.join(\"\\n- \") + \"\\n\";\n  message += `Tong no qua han: $${formattedTotalOverdue}\\n`;\n} else {\n  message += \"Tuyet voi! Khong co no xau.\\n\";\n}\n\nreturn [{ json: { summaryMessage: message } }];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[48,528],"id":"4a7fee78-2d5d-48ea-bb34-3ba12d0b28a4","name":"Code in JavaScript4"},{"parameters":{"chatId":"-5265822919","text":"={{ $json.summaryMessage }}","replyMarkup":"inlineKeyboard","inlineKeyboard":{"rows":[{"row":{"buttons":[{"text":"Send Mail to Boss","additionalFields":{"url":"={{ $resumeWebhookUrl }}"}}]}}]},"additionalFields":{}},"type":"n8n-nodes-base.telegram","typeVersion":1.2,"position":[272,528],"id":"b397f8ec-345e-43c5-bafb-63c6727135ea","name":"Send a text message3","webhookId":"cbb07b6d-6e81-4b3d-95a9-55937a4d2c7b","credentials":{"telegramApi":{"id":"0N25LYzyYyZsOUvL","name":"Telegram account"}},"onError":"continueErrorOutput"},{"parameters":{"resume":"webhook","limitWaitTime":true,"resumeAmount":2,"resumeUnit":"days","options":{}},"type":"n8n-nodes-base.wait","typeVersion":1.1,"position":[544,512],"id":"7b78ea43-6880-4958-bed5-030145c520a1","name":"Wait","webhookId":"ee65b8e3-4879-4456-a221-18c0a649d703"},{"parameters":{"chatId":"-5265822919","text":"=Tele Weekly Report sending failed.\n\nPlease check Tele node.","additionalFields":{}},"type":"n8n-nodes-base.telegram","typeVersion":1.2,"position":[448,672],"id":"396f5d86-a600-4135-8a60-ba40c4333f20","name":"Send a text message7","webhookId":"cbb07b6d-6e81-4b3d-95a9-55937a4d2c7b","credentials":{"telegramApi":{"id":"0N25LYzyYyZsOUvL","name":"Telegram account"}}},{"parameters":{"jsCode":"// Lấy dữ liệu tổng từ node báo cáo (Nhớ check lại xem node đó tên đúng là 'Code in JavaScript4' không nhé)\nlet summary = $('Code in JavaScript4').first().json;\n\n// Đã sửa lại chuỗi tìm kiếm thành KHÔNG DẤU cho khớp với nội dung báo cáo\nlet totalPaid = summary.summaryMessage.match(/Tong da thanh toan: \\$([\\d,.]+)/)?.[1] || \"0\";\nlet totalUnpaid = summary.summaryMessage.match(/Tong chua thanh toan \\(moi\\): \\$([\\d,.]+)/)?.[1] || \"0\";\n\nreturn [{\n  json: {\n    logDate: new Date().toLocaleString('vi-VN'), // Giờ VN rất chuẩn rồi\n    totalPaid: totalPaid,\n    totalUnpaid: totalUnpaid,\n    status: \"Email Sent Successfully\",\n    recipient: \"Sếp\"\n  }\n}];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[1024,496],"id":"81294f49-536d-488c-a488-abaa36fe54e7","name":"Code in JavaScript"},{"parameters":{"operation":"append","documentId":{"__rl":true,"value":"1GnunuW180KK1g_B9W7e3AMtNSVFYKU6PUxQa4M8Oi-E","mode":"list","cachedResultName":"Vendor Invoices","cachedResultUrl":"https://docs.google.com/spreadsheets/d/1GnunuW180KK1g_B9W7e3AMtNSVFYKU6PUxQa4M8Oi-E/edit?usp=drivesdk"},"sheetName":{"__rl":true,"value":419625005,"mode":"list","cachedResultName":"ReportLogs","cachedResultUrl":"https://docs.google.com/spreadsheets/d/1GnunuW180KK1g_B9W7e3AMtNSVFYKU6PUxQa4M8Oi-E/edit#gid=419625005"},"columns":{"mappingMode":"defineBelow","value":{"Log Date":"={{ $json.logDate }}","Total Paid":"={{ $json.totalPaid }}","Total Unpaid":"={{ $json.totalUnpaid }}","Status":"={{ $json.status }}","Recipient":"={{ $json.recipient }}"},"matchingColumns":[],"schema":[{"id":"Log Date","displayName":"Log Date","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true},{"id":"Total Paid","displayName":"Total Paid","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true},{"id":"Total Unpaid","displayName":"Total Unpaid","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true},{"id":"Status","displayName":"Status","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true},{"id":"Recipient","displayName":"Recipient","required"