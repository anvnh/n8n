lid #eee; }\n  .payment-info { background: #eef7f9; padding: 15px; margin-top: 20px; border-radius: 5px; }\n  .total { font-weight: bold; text-align: right; margin-top: 20px; font-size: 20px; color: #d9534f; }\n</style>\n\n<div class=\"invoice-box\">\n  <div class=\"header\">HÓA ĐƠN YÊU CẦU THANH TOÁN</div>\n  \n  <div class=\"info-group\">\n    <p><strong>Mã hóa đơn:</strong> {{ $json[\"Invoice ID\"] }}</p>\n    <p><strong>Ngày xuất:</strong> {{ $json[\"Received Date\"] }}</p>\n    <p><strong>Email người gửi:</strong> {{ $json[\"Sender\"] }}</p>\n  </div>\n  \n  <table class=\"details\">\n    <thead>\n      <tr>\n        <th>Nhà cung cấp (Vendor)</th>\n        <th style=\"text-align: right;\">Số tiền yêu cầu</th>\n      </tr>\n    </thead>\n    <tbody>\n      <tr>\n        <td>{{ $json[\"Vendor\"] }}</td>\n        <td style=\"text-align: right;\">${{ $json[\"Amount\"] }}</td>\n      </tr>\n    </tbody>\n  </table>\n\n  <div class=\"total\">Tổng cộng phải thanh toán: ${{ $json[\"Amount\"] }}</div>\n\n  <div class=\"payment-info\">\n    <h3 style=\"margin-top: 0;\">Thông tin chuyển khoản:</h3>\n    <p><strong>Ngân hàng:</strong> {{ $json[\"Bank Name\"] }}</p>\n    <p><strong>Tên tài khoản:</strong> {{ $json[\"Account Name\"] }}</p>\n    <p><strong>Số tài khoản:</strong> {{ $json[\"Account Number\"] }}</p>\n    <p><em>Vui lòng ghi rõ mã hóa đơn ({{ $json[\"Invoice ID\"] }}) trong nội dung chuyển khoản.</em></p>\n  </div>\n</div>"},"type":"n8n-nodes-base.html","typeVersion":1.2,"position":[-144,-944],"id":"3180b3ef-a971-470e-9ddf-622cdcaae1b5","name":"HTML"},{"parameters":{"html_content":"={{ $json.html }}","output_format":"file","output_filename":"invoice"},"type":"n8n-nodes-htmlcsstopdf.htmlcsstopdf","typeVersion":1,"position":[32,-944],"id":"8601e813-95df-44c1-86f6-cf4dca9acf07","name":"Convert HTML to PDF1","credentials":{"htmlcsstopdfApi":{"id":"X7LUkq4MG4RFQEx0","name":"HTML to PDF account"}}},{"parameters":{"jsCode":"let mockData = [];\nlet vendors = [\"Tech Solutions\", \"Ayolo Industry\", \"Global Corp\", \"Cloud VN\"];\n\nlet myBankAccounts = [\n  \n  {\n    bankName: \"MB Bank\",\n    bankCode: \"mb\", \n    accountNumber: \"080510051325\",\n    accountName: \"NGUYEN YEN NHI\"\n  },\n  {\n    bankName: \"MB Bank\",\n    bankCode: \"mb\", \n    accountNumber: \"0905735443\",\n    accountName: \"NGUYEN YEN NHI\"\n  },\n  {\n    bankName: \"MB Bank\",\n    bankCode: \"mb\", \n    accountNumber: \"0909011005\",\n    accountName: \"VO NGUYEN HOANG AN\"\n  },\n];\n\nfor (let i = 0; i < 1; i++) {\n  let randomNum = Math.floor(Math.random() * 1000000);\n  let amount = Math.floor(Math.random() * 1001) + 2000;\n  \n  let randomDaysAgo = Math.floor(Math.random() * 40);\n  let date = new Date();\n  date.setDate(date.getDate() - randomDaysAgo);\n  let formattedDate = date.toISOString().split('T')[0]; \n\n  let selectedVendor = vendors[Math.floor(Math.random() * vendors.length)];\n  let selectedBankAccount = myBankAccounts[Math.floor(Math.random() * myBankAccounts.length)];\n\n  mockData.push({\n    json: {\n      \"Invoice ID\": \"INV\" + randomNum,\n      \"Vendor\": selectedVendor,\n      \"Sender\": `nhinguyenthiyen1325@gmail.com`, \n      \"Received Date\": formattedDate,\n      \"Amount\": amount,\n      \"Bank Name\": selectedBankAccount.bankName,\n      \"Bank Code\": selectedBankAccount.bankCode, \n      \"Account Number\": selectedBankAccount.accountNumber,\n      \"Account Name\": selectedBankAccount.accountName \n    }\n  });\n}\n\nreturn mockData;"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[-304,-944],"id":"3d2ae7ee-1c53-4832-8fd7-38c66e7b659a","name":"Code in JavaScript3"},{"parameters":{},"type":"n8n-nodes-base.manualTrigger","typeVersion":1,"position":[-496,-944],"id":"7ec3190d-9b54-412e-9fdf-b886b5002491","name":"When clicking ‘Execute workflow’"},{"parameters":{"sendTo":"anpa.keyhubstore@gmail.com","subject":"=Yêu cầu thanh toán - {{ $('Code in JavaScript3').item.json['Invoice ID'] }}","message":"=Dear Customer,  Please be advised that a new invoice has been generated for your recent order/service.  The digital copy of your invoice is attached to this email. Please review the details and proceed with the payment according to the instructions provided within the document.  If you have any questions regarding this invoice, please contact our support team.  Thank you for your business.   Best regards, {{ $('Code in JavaScript3').item.json.Vendor }} Team","options":{"attachmentsUi":{"attachmentsBinary":[{}]}}},"type":"n8n-nodes-base.gmail","typeVersion":2.2,"position":[224,-944],"id":"74b47f8c-0ebc-4ddf-a39b-54825bcd6ed7","name":"Send a message2","webhookId":"19c905f0-23be-49bc-922c-4b3f8b1f7fb7","credentials":{"gmailOAuth2":{"id":"e8qAdikal9FNaN3k","name":"Gmail account 2"}}},{"parameters":{"resource":"image","operation":"analyze","modelId":{"__rl":true,"value":"models/gemini-2.5-flash","mode":"list","cachedResultName":"models/gemini-2.5-flash"},"text":"Extract the following information from this Techcombank transfer receipt image. Use the English labels to locate the exact data:\n1. Amount: Located at the top, on the line starting with \"VND\". Remove \"VND\" and commas, return only the integer number (e.g., 2500).\n2. Bank Account: Located under \"Beneficiary account\", it is the numeric string at the bottom of that section. Remove any spaces between the numbers.\n3. Transfer Content: Located exactly under the label \"Message\". Extract the exact string preserving all characters, including hyphens ('-') (e.g., 'AB-XD-12345').\n4. Transaction Date: Located under the label \"Transfer date\". Convert this to YYYY/MM/DD HH:mm format.\n5. Bank Transaction ID: Located exactly under the label \"Transaction ID\".\n\nReturn the result STRICTLY in JSON format with the following keys:\n{\n  \"Transaction Id\": \"...\",\n  \"Amount\": \"...\",\n  \"Transfer Content\": \"...\",\n  \"Bank Account\": \"...\",\n  \"Payment Date\": \"...\"\n}","inputType":"binary","options":{}},"type":"@n8n/n8n-nodes-langchain.googleGemini","typeVersion":1.1,"position":[-240,-32],"id":"cc840fe2-9aa1-49b6-945c-349a6f559ab4","name":"Analyze an image","retryOnFail":true,"credentials":{"googlePalmApi":{"id":"sbcQEveatdVnXamG","name":"Google Gemini(PaLM) Api account"}}},{"parameters":{"updates":["message"],"additionalFields":{"download":true}},"type":"n8n-nodes-base.telegramTrigger","typeVersion":1.2,"position":[-528,-32],"id":"8b0690d1-dbcb-43c3-8232-c6c61cedd88e","name":"Telegram Trigger","webhookId":"c4bf3817-7022-4df2-92c4-02a0e68225ad","credentials":{"telegramApi":{"id":"aNP62EoE718yCrLS","name":"Telegram account"}}},{"parameters":{"jsCode":"// Lấy cục text thô từ Gemini\nlet rawText = $input.item.json.content.parts[0].text;\n\n// Cắt bỏ mấy cái dấu markdown dư thừa để chừa lại data can JSON\nlet cleanText = rawText.replace(/```json/g, '').replace(/```/g, '').trim();\n\n// Biến nó thành dữ liệu thật\nlet parsedData = JSON.parse(cleanText);\n\nreturn parsedData;"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[16,-32],"id":"0e8e2969-b47b-47f2-be64-b850f22c39eb","name":"Code in JavaScript1"},{"parameters":{"documentId":{"__rl":true,"value":"1GnunuW180KK1g_B9W7e3AMtNSVFYKU6PUxQa4M8Oi-E","mode":"list","cachedResultName":"Vendor Invoices","cachedResultUrl":"https://docs.google.com/spreadsheets/d/1GnunuW180KK1g_B9W7e3AMtNSVFYKU6PUxQa4M8Oi-E/edit?usp=drivesdk"},"sheetName":{"__rl":true,"value":"gid=0","mode":"list","cachedResultName":"Sheet1","cachedResultUrl":"https://docs.google.com/spreadsheets/d/1GnunuW180KK1g_B9W7e3AMtNSVFYKU6PUxQa4M8Oi-E/edit#gid=0"},"filtersUI":{"values":[{"lookupColumn":"=Invoice ID","lookupValue":"={{ $json['Invoice ID'] }}"}]},"options":{}},"type":"n8n-nodes-base.googleSheets","typeVersion":4.7,"position":[2784,-576],"id":"639b7186-a165-4afb-b5c7-cdb7b07ceb97","name":"Get row(s) in sheet2","credentials":{"googleSheetsOAuth2Api":{"id":"o1kE8qisggsh0P69","name":"Google Sheets account"}}},{"parameters":{"mode":"combine","combineBy":"combineByPosition","options":{}},"type":"n8n-nodes-base.merge","typeVersion":3.2,"position":[592,144],"id":"25b1ddee-3b82-4d96-adcf-61e21dfa06c7","name":"Merge"},{"parameters":{"aggregate":"aggregateAllItemData","options":{}},"type":"n8n-nodes-base.aggregate","typeVersion":1,"position":[128,-336],"id":"07bded73-5c9e-4932-84e5-f753cdf8ddd4","name":"Aggregate"},{"parameters":{"chatId":"-5265822919","text":"=No invoices available for payment","additionalFields":{}},"type":"n8n-nodes-base.telegram","typeVersion":1.2,"position":[304,-336],"id":"c5eb995c-67f3-4e2e-b14c-c24768acc247","name":"Send a text message2","webhookId":"57c1c64b-dc1a-4d93-8359-6540ef62ccb0","credentials":{"telegramApi":{"id":"aNP62EoE718yCrLS","name":"Telegram account"}}},{"parameters":{"operation":"sendPhoto","chatId":"-5265822919","file":"={{ $json.qr_link }}","replyMarkup":"forceReply","forceReply":{"force_reply":true,"selective":false},"additionalFields":{"caption":"=YEU CAU THANH TOAN MOI  \nMa hoa don: {{ $json.id }} \nNha cung cap:  \nNguoi yeu cau: {{ $json.sender }} \nTong tien:{{ $json.amount }} USD \nNgan hang: {{ $json.bank_name }}  \n---------------------------- \nKe toan vui long quet ma QR de thuc hien chuyen khoan. Sau khi hoan tat, vui long phan hoi (reply) kem anh chup man hinh bien lai de he thong ghi nhan."}},"type":"n8n-nodes-base.telegram","typeVersion":1.2,"position":[368,-560],"id":"b8bcef93-5140-4f9f-a731-97bc3bf8faff","name":"Send a QR code's photo message","webhookId":"4a3e44f1-9764-40e8-9e64-c0cd84f7a1e6","credentials":{"telegramApi":{"id":"aNP62EoE718yCrLS","name":"Telegram account"}}},{"parameters":{"jsCode":"let amount = $input.first().json.amount\nlet accountNum = $input.first().json.account_number\nlet accountName = $input.first().json.account_name\nlet invoiceId = $input.first().json.id\nlet bankName = $input.first().json.bank_name\nlet bankCode = $input.first().json.bank_code\n\nif (!bankCode) {\n  throw new Error(`Chưa có mã Bank Code cho ngân hàng: ${bankName}. Vui lòng thêm vào code!`);\n}\n\n// 3. TẠO LINK QR\nlet qrLink = `https://img.vietqr.io/image/${bankCode}-${accountNum}-compact2.png?amount=${amount}&addInfo=${encodeURIComponent(invoiceId)}&accountName=${encodeURIComponent(accountName)}`;\n\nreturn [{\n  json: {\n    ...$input.first().json,\n    qr_link: qrLink\n  }\n}];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[160,-560],"id":"a5e3744b-9bd5-4fa2-9f11-351c4aaa3b0e","name":"Create VietQR "},{"parameters":{"jsCode":"const mergeItems = $('Merge').all();\nlet totalAmount = 0;\n\nconst lines = mergeItems.map((item, index) => {\n  const invoiceId = item.json.id || \"N/A\";\n  const transactionId = item.json.transaction_id || \"N/A\";\n  const amount = Number(item.json.amount) || 0;\n\n  totalAmount += amount;\n\n  return `${index + 1}. Invoice ${invoiceId} has been paid.\\nTransaction ID: ${transactionId}\\nAmount: ${amount}`;\n});\n\nconst message = `Payment completed for ${mergeItems.length} invoice(s).\\nTotal amount: $${totalAmount}\\n\\n${lines.join('\\n\\n')}`;\n\nreturn [{ json: { message } }];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[1008,-112],"id":"709f1c76-8aa1-4fad-a570-e49d941085c2","name":"Payment Summary"},{"parameters":{"jsCode":"let paidItems = [];\nlet unpaidItems = [];\nlet overdueItems = []; \nlet totalPaid = 0;\nlet totalUnpaid = 0;\nlet totalOverdue = 0;\n\nlet reportDate = $input.first().json['Report Date'] || 'Chưa xác định';\n\nlet today = new Date();\nlet sevenDaysAgo = new Date(today);\nsevenDaysAgo.setDate(today.getDate() - 7);\n\nlet thirtyDaysAgo = new Date(today);\nthirtyDaysAgo.setDate(today.getDate() - 30);\n\n// Sửa tên node đầu vào\nlet tableData = $('Select rows from a table1').all();\n\nfor (let item of tableData) {\n  // Sửa keys theo format của Postgres\n  let status = item.json.status; \n  let invoiceID = item.json.id;     \n  let amount = parseFloat(item.json.amount) || 0; \n  let formattedAmount = amount.toLocaleString('en-US');\n  \n  let receivedDate = new Date(item.json.received_date); \n  let paymentDate = item.json.payment_date ? new Date(item.json.payment_date) : null;\n\n  if (status === 'Paid' || status === 'paid') { \n    if (paymentDate && paymentDate >= sevenDaysAgo) {\n        paidItems.push(`${invoiceID} ($${formattedAmount})`);\n        totalPaid += amount;\n    }\n  } else {\n  \n    if (receivedDate < thirtyDaysAgo) {\n        overdueItems.push(`${invoiceID} ($${formattedAmount})`);\n        totalOverdue += amount;\n    } else {\n        unpaidItems.push(`${invoiceID} ($${formattedAmount})`);\n        totalUnpaid += amount;\n    }\n  }\n}\n\nlet formattedTotalPaid = totalPaid.toLocaleString('en-US');\nlet formattedTotalUnpaid = totalUnpaid.toLocaleString('en-US');\nlet formattedTotalOverdue = totalOverdue.toLocaleString('en-US');\n\nlet message = \"WEEKLY PAYMENT REPORT\\n\";\nmessage += `Date: ${reportDate}\\n\\n`;\n\nmessage += \"PAID (Last 7 days):\\n\";\nif (paidItems.length > 0) {\n  message += \"- \" + paidItems.join(\"\\n- \") + \"\\n\";\n  message += `Total Paid: $${formattedTotalPaid}\\n\\n`;\n} else {\n  message += \"No invoices paid this week.\\n\\n\";\n}\n\nmessage += \"UNPAID (Pending/New):\\n\";\nif (unpaidItems.length > 0) {\n  message += \"- \" + unpaidItems.join(\"\\n- \") + \"\\n\";\n  message += `Total Outstanding: $${formattedTotalUnpaid}\\n\\n`;\n} else {\n  message += \"No pending invoices.\\n\\n\";\n}\n\nmessage += \"OVERDUE (Over 30 days - Action Required):\\n\";\nif (overdueItems.length > 0) {\n  message += \"- \" + overdueItems.join(\"\\n- \") + \"\\n\";\n  message += `Total Overdue Amount: $${formattedTotalOverdue}\\n`;\n} else {\n  message += \"No bad debt recorded.\\n\";\n}\n\nreturn [{ json: { summaryMessage: message } }];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[128,528],"id":"4a7fee78-2d5d-48ea-bb34-3ba12d0b28a4","name":"Create weekly report"},{"parameters":{"chatId":"-5265822919","text":"={{ $json.summaryMessage }}","replyMarkup":"inlineKeyboard","inlineKeyboard":{"rows":[{"row":{"buttons":[{"text":"Send Mail to Manager","additionalFields":{"url":"={{ $resumeWebhookUrl }}"}}]}}]},"additionalFields":{}},"type":"n8n-nodes-base.telegram","typeVersion":1.2,"position":[352,528],"id":"b397f8ec-345e-43c5-bafb-63c6727135ea","name":"Send a text + button send to manager","webhookId":"cbb07b6d-6e81-4b3d-95a9-55937a4d2c7b","credentials":{"telegramApi":{"id":"aNP62EoE718yCrLS","name":"Telegram account"}},"onError":"continueErrorOutput"},{"parameters":{"sendTo":"=anvo20052@gmail.com","subject":"Weekly Payment Report","message":"={{ $('Send a text + button send to manager').item.json.result.text }}","options":{}},"type":"n8n-nodes-base.gmail","typeVersion":2.2,"position":[816,512],"id":"ca971794-8d89-482b-a490-43430e738d8b","name":"Send mail to manager","webhookId":"47756250-e1ae-4ba5-869f-9088ea0a0a1e","credentials":{"gmailOAuth2":{"id":"beDvSOTB7bO9NJB0","name":"Gmail account"}},"onError":"continueErrorOutput"},{"parameters":{"jsCode":"\nlet summary = $('Create weekly report').first().json;\n\nlet totalPaid = summary.summaryMessage.match(/Tong da thanh toan: \\$([\\d,.]+)/)?.[1] || \"0\";\nlet totalUnpaid = summary.summaryMessage.match(/Tong chua thanh toan \\(moi\\): \\$([\\d,.]+)/)?.[1] || \"0\";\n\nreturn [{\n  json: {\n    logDate: new Date().toLocaleString('vi-VN'), \n    totalPaid: totalPaid,\n    totalUnpaid: totalUnpaid,\n    status: \"Email Sent Successfully\",\n    recipient: \"Manager\"\n  }\n}];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[1104,496],"id":"81294f49-536d-488c-a488-abaa36fe54e7","name":"Log history report"},{"parameters":{"operation":"executeQuery","query":"SELECT * FROM invoices where status = 'Approved'","options":{}},"type":"n8n-nodes-base.postgres","typeVersion":2.6,"position":[-288,-544],"id":"cd0d166d-2c52-4f85-9053-a9d84ee19134","name":"Execute a SQL query","credentials":{"postgres":{"id":"0C0rrqNwGHOWr3HU","name":"Postgres account"}}},{"parameters":{"operation":"se